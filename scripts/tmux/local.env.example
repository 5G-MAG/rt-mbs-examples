# User-specific paths for the tmux tutorial scripts
# (mbs-function-tutorial.sh and mbs-transport-function-tutorial.sh).
#
# Copy this file to local.env in the same folder and adjust the paths to your
# setup. local.env is gitignored, so your paths never end up in a pull request.
# Any variable left commented out keeps the script's default value.

# Open5GS with MBS support (https://github.com/5G-MAG/open5gs)
#OPEN5GS_BASE_DIR="$HOME/open5gs_mbs/install/bin"
#OPEN5GS_CONFIG_DIR="$HOME/open5gs_mbs/install/etc/open5gs"

# MBSTF (https://github.com/5G-MAG/rt-mbs-transport-function)
#MBSTF_BASE_DIR="$HOME/rt-mbs-transport-function/build/src/mbstf"
#MBSTF_CONFIG_DIR="$HOME/rt-mbs-transport-function/build/src/mbstf"

# MBSF (https://github.com/5G-MAG/rt-mbs-function), only used by mbs-function-tutorial.sh
#MBSF_BASE_DIR="$HOME/rt-mbs-function/build/src/mbsf"
#MBSF_CONFIG_DIR="$HOME/rt-mbs-function/build/src/mbsf"

# Mock media server. Defaults to the copy inside this repository, so it usually
# does not need to be set.
#MEDIA_SERVER_DIR="$HOME/rt-mbs-examples/express-mock-media-server"

# Log directory for the Open5GS network functions
#LOG_DIR="/var/local/log/open5gs"
