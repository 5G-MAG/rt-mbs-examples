# Machine-specific paths for this demo. Copy to local.env beside it and edit; local.env is
# gitignored, so your layout never lands in a commit.
#
#   cp local.env.example local.env
#
# env.sh reads this before computing any default, so setting a root here is enough when your
# checkouts are grouped. Set the individual directories only where a component sits somewhere
# the roots do not explain. Everything is commented out: uncomment what you actually need.
#
# `./demo doctor` lists whatever it cannot find and names the variable that moves it.

# ---- roots -------------------------------------------------------------------------
# Where the repositories are checked out. The default is $HOME/Repos, which is one
# development machine's habit and nothing more.
#REPOS_ROOT="$HOME/Repos"

# The MBS repositories, if they are grouped in a subdirectory of REPOS_ROOT.
# Set this to REPOS_ROOT itself if you cloned them all side by side.
#RTMBS_ROOT="$REPOS_ROOT/rt-mbs"

# Parent of srsRAN_Project_mbs and srsRAN_4G_mbs.
#RAN_ROOT="$REPOS_ROOT"

# ---- individual components --------------------------------------------------------
# Only needed when a component is not where the roots above put it.
#OPEN5GS_DIR="$REPOS_ROOT/open5gs"
#MBSF_DIR="$RTMBS_ROOT/rt-mbs-function"
#MBSTF_DIR="$RTMBS_ROOT/rt-mbs-transport-function"
#CLIENT_DIR="$RTMBS_ROOT/rt-mbs-client"
#APP_DIR="$RTMBS_ROOT/rt-mbs-application"
#PROVIDER_DIR="$RTMBS_ROOT/rt-mbs-application-provider"
#MEDIA_DIR="$RTMBS_ROOT/rt-mbs-examples/express-mock-media-server"
#GNB_DIR="$RAN_ROOT/srsRAN_Project_mbs"
#UE_DIR="$RAN_ROOT/srsRAN_4G_mbs"

# ---- built binaries ---------------------------------------------------------------
# These default to an in-tree build/ under each component, which is how this project
# builds them. Set them if you build out of tree or install somewhere.
#MBSF_BUILD="$MBSF_DIR/build"
#MBSTF_BUILD="$MBSTF_DIR/build"
#CLIENT_BIN="$CLIENT_DIR/build/mbs-client"
#GNB_BIN="$GNB_DIR/build/apps/gnb/gnb"
#UE_BIN="$UE_DIR/build/srsue/src/srsue"

# ---- demo content ------------------------------------------------------------------
# Source clips the channel line-up names. Required; without it the encoders have nothing
# to loop and the demo comes up with an empty origin.
#CONTENT_ROOT="$HOME/MWC_TV_RADIO"
